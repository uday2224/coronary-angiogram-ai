# Flask server
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=True

# CORS — must match the frontend origin exactly
FRONTEND_ORIGIN=http://localhost:5173

# Upload limit in megabytes
MAX_UPLOAD_MB=12

# Model configuration
# MODEL_TYPE: "smp_unet" for segmentation-models-pytorch U-Net
MODEL_TYPE=smp_unet
MODEL_PATH=models/arcade_stenosis_unet_best.pth
SEGMENTATION_THRESHOLD=0.3

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
